<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/gradient_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/main_menu_desc"
                app:tint="#1E1E1E" />
        </LinearLayout>

        <!-- Счетчик залов и кнопка создания -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHallsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_label_features"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddHall"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/admin_btn_add"
                app:backgroundTint="#F8A242"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_orange"/>
        </LinearLayout>

        <!-- Список залов -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:contentDescription="@string/admin_title">

            <LinearLayout
                android:id="@+id/hallsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Меню -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0A55B"
        app:menu="@menu/menu_main"
        app:itemTextColor="#FFFFFF"
        app:itemIconTint="#1E1E1E" />
</androidx.drawerlayout.widget.DrawerLayout>